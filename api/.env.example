# Copy to .env and fill in. Never commit .env.

# HTTP
PORT=3000
WEB_ORIGIN=http://localhost:5173

# Neon Postgres connection string (Dashboard -> Connection Details -> Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Google OAuth (Google Cloud Console -> Credentials -> OAuth client ID, Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Where to send the browser after a successful login
POST_LOGIN_REDIRECT=http://localhost:5173/dashboard

# Session signing (any long random string; generate with: openssl rand -hex 32)
JWT_SECRET=
